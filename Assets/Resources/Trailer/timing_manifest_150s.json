          "start_sec": 106.59453514739229,
          "end_sec": 107.95392290249433,
          "scene_tag": "scene_12"
        },
        {
          "id": "150s_scene_12_03",
          "text": "在海水淹没它之前，",
          "file": "sentences/150s_scene_12_03.wav",
          "duration_sec": 1.764875283446712,
          "start_sec": 108.07392290249433,
          "end_sec": 109.83879818594104,
          "scene_tag": "scene_12"
        },
        {
          "id": "150s_scene_12_04",
          "text": "能不能再亮一次。",
          "file": "sentences/150s_scene_12_04.wav",
          "duration_sec": 1.3999092970521543,
          "start_sec": 109.95879818594105,
          "end_sec": 111.3587074829932,
          "scene_tag": "scene_12"
        }
      ],
      "start_sec": 105,
      "end_sec": 113.951731
    },
    {
      "scene_tag": "scene_13",
      "act": "第五幕 · 高潮：灯塔",
      "original_start_sec": 113,
      "original_end_sec": 119,
      "text": "灯亮了。光越过海面，照到山的那一边。",
      "visual": "镜头拉出到桌面：手转开发板旋钮，屏幕里灯头同步转动，光束扫过海面推向远山（见第六节）",
      "sentences": [
        {
          "id": "150s_scene_13_01",
          "text": "灯亮了。",
          "file": "sentences/150s_scene_13_01.wav",
          "duration_sec": 0.7193877551020408,
          "start_sec": 114.03172335600907,
          "end_sec": 114.75111111111111,
          "scene_tag": "scene_13"
        },
        {
          "id": "150s_scene_13_02",
          "text": "光越过海面，照到山的那一边。",
          "file": "sentences/150s_scene_13_02.wav",
          "duration_sec": 2.540045351473923,
          "start_sec": 114.8711111111111,
          "end_sec": 117.41115646258504,
          "scene_tag": "scene_13"
        }
      ],
      "start_sec": 113.951731,
      "end_sec": 119.375932
    },
    {
      "scene_tag": "scene_14",
      "act": "第五幕 · 高潮：灯塔",
      "original_start_sec": 119,
      "original_end_sec": 128,
      "text": "山上，四十盏手电，一盏一盏亮了起来。搬走的人们，都看见了。",
      "visual": "对岸山头手电依次亮起，全景定格 1 秒",
      "sentences": [
        {
          "id": "150s_scene_14_01",
          "text": "山上，四十盏手电，",
          "file": "sentences/150s_scene_14_01.wav",
          "duration_sec": 1.9449659863945579,
          "start_sec": 119.4559410430839,
          "end_sec": 121.40090702947846,
          "scene_tag": "scene_14"
        },
        {
          "id": "150s_scene_14_02",
          "text": "一盏一盏亮了起来。",
          "file": "sentences/150s_scene_14_02.wav",
          "duration_sec": 1.471111111111111,
          "start_sec": 121.52090702947845,
          "end_sec": 122.99201814058956,
          "scene_tag": "scene_14"
        },
        {
          "id": "150s_scene_14_03",
          "text": "搬走的人们，都看见了。",
          "file": "sentences/150s_scene_14_03.wav",
          "duration_sec": 1.9808390022675737,
          "start_sec": 123.11201814058957,
          "end_sec": 125.09285714285714,
          "scene_tag": "scene_14"
        }
      ],
      "start_sec": 119.375932,
      "end_sec": 128.0
    },
    {
      "scene_tag": "scene_15",
      "act": "尾声 · 反转与点题",
      "original_start_sec": 128,
      "original_end_sec": 138,
      "text": "回到邮局，还有最后一封信。收信人是 EGGBOY 自己。——回家吧。山这边的新邮局，一直给你留着位置。",
      "visual": "回到邮局桌前，信封上写着 EGGBOY；信纸展开；EGGBOY 回头看黄昏里的潮汐镇",
      "sentences": [
        {
          "id": "150s_scene_15_01",
          "text": "回到邮局，还有最后一封信。",
          "file": "sentences/150s_scene_15_01.wav",
          "duration_sec": 2.321111111111111,
          "start_sec": 128.08,
          "end_sec": 130.4011111111111,
          "scene_tag": "scene_15"
        },
        {
          "id": "150s_scene_15_02",
          "text": "收信人是 EGGBOY 自己。",
          "file": "sentences/150s_scene_15_02.wav",
          "duration_sec": 1.9751020408163265,
          "start_sec": 130.5211111111111,
          "end_sec": 132.49621315192744,
          "scene_tag": "scene_15"
        },
        {
          "id": "150s_scene_15_03",
          "text": "——回家吧。",
          "file": "sentences/150s_scene_15_03.wav",
          "duration_sec": 0.7425396825396825,
          "start_sec": 132.61621315192744,
          "end_sec": 133.3587528344671,
          "scene_tag": "scene_15"
        },
        {
          "id": "150s_scene_15_04",
          "text": "山这边的新邮局，",
          "file": "sentences/150s_scene_15_04.wav",
          "duration_sec": 1.5310884353741496,
          "start_sec": 133.47875283446712,
          "end_sec": 135.00984126984127,
          "scene_tag": "scene_15"
        },
        {
          "id": "150s_scene_15_05",
          "text": "一直给你留着位置。",
          "file": "sentences/150s_scene_15_05.wav",
          "duration_sec": 1.541904761904762,
          "start_sec": 135.12984126984128,
          "end_sec": 136.67174603174604,
          "scene_tag": "scene_15"
        }
      ],
      "start_sec": 128,
      "end_sec": 136.918413
    },
    {
      "scene_tag": "scene_16",
      "act": "尾声 · 反转与点题",
      "original_start_sec": 138,
      "original_end_sec": 146,
      "text": "这座小镇里的每一栋房子、每一件旧物，都由 Lux3D 生成。而你写下的心愿，也会在这里，变成真的。",
      "visual": "镜头缓缓拉远到整座小岛；画面右侧淡入 3 件 Lux3D 资产转台小窗（邮局、灯塔、心愿骨头）",
      "sentences": [
        {
          "id": "150s_scene_16_01",
          "text": "这座小镇里的每一栋房子、",
          "file": "sentences/150s_scene_16_01.wav",
          "duration_sec": 2.0034467120181407,
          "start_sec": 136.9984126984127,
          "end_sec": 139.00185941043082,
          "scene_tag": "scene_16"
        },
        {
          "id": "150s_scene_16_02",
          "text": "每一件旧物，都由 Lux3D 生成。",
          "file": "sentences/150s_scene_16_02.wav",
          "duration_sec": 2.886394557823129,
          "start_sec": 139.12185941043083,
          "end_sec": 142.00825396825397,
          "scene_tag": "scene_16"
        },
        {
          "id": "150s_scene_16_03",
          "text": "而你写下的心愿，",
          "file": "sentences/150s_scene_16_03.wav",
          "duration_sec": 1.4335147392290248,
          "start_sec": 142.12825396825397,
          "end_sec": 143.561768707483,
          "scene_tag": "scene_16"
        },
        {
          "id": "150s_scene_16_04",
          "text": "也会在这里，变成真的。",
          "file": "sentences/150s_scene_16_04.wav",
          "duration_sec": 2.1048979591836736,
          "start_sec": 143.681768707483,
          "end_sec": 145.78666666666666,
          "scene_tag": "scene_16"
        }
      ],
      "start_sec": 136.918413,
      "end_sec": 146.0
    },
    {
      "scene_tag": "scene_17",
      "act": "尾声 · 反转与点题",
      "original_start_sec": 146,
      "original_end_sec": 150,
      "text": "（无旁白）",
      "visual": "片尾卡：记忆邮局 · 还在送 ／ 队名：收信人 ／ `#Aholo黑客松` ／ GitHub 地址",
      "sentences": [],
      "start_sec": 146,
      "end_sec": 150
    }
  ],
  "sentences": [
    {
      "id": "150s_scene_01_01",
      "text": "潮汐镇的人，都搬走了。",
      "file": "sentences/150s_scene_01_01.wav",
      "duration_sec": 2.039002267573696,
      "start_sec": 0.08,
      "end_sec": 2.119002267573696,
      "scene_tag": "scene_01"
    },
    {
      "id": "150s_scene_01_02",
      "text": "海水一天比一天高，",
      "file": "sentences/150s_scene_01_02.wav",
      "duration_sec": 1.5782086167800453,
      "start_sec": 2.2390022675736962,
      "end_sec": 3.8172108843537416,
      "scene_tag": "scene_01"
    },
    {
      "id": "150s_scene_01_03",
      "text": "没有人再回来。",
      "file": "sentences/150s_scene_01_03.wav",
      "duration_sec": 1.1049433106575963,
      "start_sec": 3.9372108843537417,
      "end_sec": 5.042154195011338,
      "scene_tag": "scene_01"
    },
    {
      "id": "150s_scene_02_01",
      "text": "只有邮局里的小机器人 EGGBOY，",
      "file": "sentences/150s_scene_02_01.wav",
      "duration_sec": 2.358730158730159,
      "start_sec": 8.291995464852608,
      "end_sec": 10.650725623582767,
      "scene_tag": "scene_02"
    },
    {
      "id": "150s_scene_02_02",
      "text": "每天早上醒来，",
      "file": "sentences/150s_scene_02_02.wav",
      "duration_sec": 1.340748299319728,
      "start_sec": 10.770725623582766,
      "end_sec": 12.111473922902494,
      "scene_tag": "scene_02"
    },
    {
      "id": "150s_scene_02_03",
      "text": "背起邮包，照常出门。",
      "file": "sentences/150s_scene_02_03.wav",
      "duration_sec": 1.9502721088435375,
      "start_sec": 12.231473922902495,
      "end_sec": 14.181746031746032,
      "scene_tag": "scene_02"
    },
    {
      "id": "150s_scene_03_01",
      "text": "它送的信，收信人都已经不在了。",
      "file": "sentences/150s_scene_03_01.wav",
      "duration_sec": 2.8443537414965987,
      "start_sec": 20.08,
      "end_sec": 22.9243537414966,
      "scene_tag": "scene_03"
    },
    {
      "id": "150s_scene_03_02",
      "text": "林阿婆写给陪了她四十二年的烤炉：",
      "file": "sentences/150s_scene_03_02.wav",
      "duration_sec": 2.85437641723356,
      "start_sec": 23.0443537414966,
      "end_sec": 25.89873015873016,
      "scene_tag": "scene_03"
    },
    {
      "id": "150s_scene_03_03",
      "text": "老伙计，请再生一次火吧。",
      "file": "sentences/150s_scene_03_03.wav",
      "duration_sec": 2.201315192743764,
      "start_sec": 26.018730158730158,
      "end_sec": 28.220045351473924,
      "scene_tag": "scene_03"
    },
    {
      "id": "150s_scene_04_01",
      "text": "可是火柴受了潮，",
      "file": "sentences/150s_scene_04_01.wav",
      "duration_sec": 1.4060997732426304,
      "start_sec": 31.68798185941043,
      "end_sec": 33.09408163265306,
      "scene_tag": "scene_04"
    },
    {
      "id": "150s_scene_04_02",
      "text": "柴也是湿的。",
      "file": "sentences/150s_scene_04_02.wav",
      "duration_sec": 1.0672562358276645,
      "start_sec": 33.21408163265306,
      "end_sec": 34.281337868480726,
      "scene_tag": "scene_04"
    },
    {
      "id": "150s_scene_05_01",
      "text": "EGGBOY 把信里的「柴火」两个字撕下来，",
      "file": "sentences/150s_scene_05_01.wav",
      "duration_sec": 2.7337868480725622,
      "start_sec": 36.09530612244898,
      "end_sec": 38.82909297052154,
      "scene_tag": "scene_05"
    },
    {
      "id": "150s_scene_05_02",
      "text": "扔出去，地上真的长出一捆柴——",
      "file": "sentences/150s_scene_05_02.wav",
      "duration_sec": 2.61562358276644,
      "start_sec": 38.94909297052154,
      "end_sec": 41.56471655328798,
      "scene_tag": "scene_05"
    },
    {
      "id": "150s_scene_05_03",
      "text": "只是湿漉漉的，",
      "file": "sentences/150s_scene_05_03.wav",
      "duration_sec": 1.2298639455782312,
      "start_sec": 41.684716553287984,
      "end_sec": 42.914580498866215,
      "scene_tag": "scene_05"
    },
    {
      "id": "150s_scene_05_04",
      "text": "点不着。",
      "file": "sentences/150s_scene_05_04.wav",
      "duration_sec": 0.7342403628117914,
      "start_sec": 43.03458049886621,
      "end_sec": 43.768820861678,
      "scene_tag": "scene_05"
    },
    {
      "id": "150s_scene_06_01",
      "text": "它想起另一封信里，",
      "file": "sentences/150s_scene_06_01.wav",
      "duration_sec": 1.467142857142857,
      "start_sec": 47.236757369614516,
      "end_sec": 48.70390022675737,
      "scene_tag": "scene_06"
    },
    {
      "id": "150s_scene_06_02",
      "text": "有一个「干」字。",
      "file": "sentences/150s_scene_06_02.wav",
      "duration_sec": 1.0029705215419502,
      "start_sec": 48.82390022675737,
      "end_sec": 49.82687074829932,
      "scene_tag": "scene_06"
    },
    {
      "id": "150s_scene_06_03",
      "text": "拼在一起，再扔一次。",
      "file": "sentences/150s_scene_06_03.wav",
      "duration_sec": 1.9692290249433106,
      "start_sec": 49.94687074829932,
      "end_sec": 51.91609977324263,
      "scene_tag": "scene_06"
    },
    {
      "id": "150s_scene_06_04",
      "text": "炉火，烧起来了。",
      "file": "sentences/150s_scene_06_04.wav",
      "duration_sec": 1.5835827664399094,
      "start_sec": 52.03609977324263,
      "end_sec": 53.61968253968254,
      "scene_tag": "scene_06"
    },
    {
      "id": "150s_scene_07_01",
      "text": "在这个小镇，信里写过的东西，",
      "file": "sentences/150s_scene_07_01.wav",
      "duration_sec": 2.546439909297052,
      "start_sec": 58.08,
      "end_sec": 60.626439909297055,
      "scene_tag": "scene_07"
    },
    {
      "id": "150s_scene_07_02",
      "text": "都能变成真的。",
      "file": "sentences/150s_scene_07_02.wav",
      "duration_sec": 1.2547392290249433,
      "start_sec": 60.74643990929705,
      "end_sec": 62.001179138321994,
      "scene_tag": "scene_07"
    },
    {
      "id": "150s_scene_07_03",
      "text": "阿萤写信给走丢的小狗小黑：",
      "file": "sentences/150s_scene_07_03.wav",
      "duration_sec": 2.447482993197279,
      "start_sec": 62.121179138322,
      "end_sec": 64.56866213151928,
      "scene_tag": "scene_07"
    },
    {
      "id": "150s_scene_07_04",
      "text": "我把你的碗，放回了学校后门。",
      "file": "sentences/150s_scene_07_04.wav",
      "duration_sec": 2.437074829931973,
      "start_sec": 64.68866213151928,
      "end_sec": 67.12573696145125,
      "scene_tag": "scene_07"
    },
    {
      "id": "150s_scene_08_01",
      "text": "碗是空的。",
      "file": "sentences/150s_scene_08_01.wav",
      "duration_sec": 0.8979365079365079,
      "start_sec": 69.4633560090703,
      "end_sec": 70.3612925170068,
      "scene_tag": "scene_08"
    },
    {
      "id": "150s_scene_08_02",
      "text": "EGGBOY 在心愿笺上写下「一根香喷喷的骨头」，",
      "file": "sentences/150s_scene_08_02.wav",
      "duration_sec": 3.513718820861678,
      "start_sec": 70.4812925170068,
      "end_sec": 73.99501133786848,
      "scene_tag": "scene_08"
    },
    {
      "id": "150s_scene_08_03",
      "text": "骨头就从纸上长了出来。",
      "file": "sentences/150s_scene_08_03.wav",
      "duration_sec": 1.96156462585034,
      "start_sec": 74.11501133786848,
      "end_sec": 76.07657596371882,
      "scene_tag": "scene_08"
    },
    {
      "id": "150s_scene_09_01",
      "text": "小黑从滑梯底下，",
      "file": "sentences/150s_scene_09_01.wav",
      "duration_sec": 1.5879591836734694,
      "start_sec": 78.1964172335601,
      "end_sec": 79.78437641723356,
      "scene_tag": "scene_09"
    },
    {
      "id": "150s_scene_09_02",
      "text": "探出了头。",
      "file": "sentences/150s_scene_09_02.wav",
      "duration_sec": 0.9268253968253968,
      "start_sec": 79.90437641723356,
      "end_sec": 80.83120181405896,
      "scene_tag": "scene_09"
    },
    {
      "id": "150s_scene_10_01",
      "text": "潮水漫过了渡口。",
      "file": "sentences/150s_scene_10_01.wav",
      "duration_sec": 1.449501133786848,
      "start_sec": 82.08,
      "end_sec": 83.52950113378685,
      "scene_tag": "scene_10"
    },
    {
      "id": "150s_scene_10_02",
      "text": "一个人摇不动绞盘，",
      "file": "sentences/150s_scene_10_02.wav",
      "duration_sec": 1.5869160997732425,
      "start_sec": 83.64950113378684,
      "end_sec": 85.23641723356009,
      "scene_tag": "scene_10"
    },
    {
      "id": "150s_scene_10_03",
      "text": "它就按下怀表，",
      "file": "sentences/150s_scene_10_03.wav",
      "duration_sec": 1.2654421768707482,
      "start_sec": 85.3564172335601,
      "end_sec": 86.62185941043084,
      "scene_tag": "scene_10"
    },
    {
      "id": "150s_scene_10_04",
      "text": "让十秒前的自己回来搭把手。",
      "file": "sentences/150s_scene_10_04.wav",
      "duration_sec": 2.5112698412698413,
      "start_sec": 86.74185941043083,
      "end_sec": 89.25312925170068,
      "scene_tag": "scene_10"
    },
    {
      "id": "150s_scene_11_01",
      "text": "断崖上没有桥，",
      "file": "sentences/150s_scene_11_01.wav",
      "duration_sec": 1.2805668934240362,
      "start_sec": 93.75913832199547,
      "end_sec": 95.0397052154195,
      "scene_tag": "scene_11"
    },
    {
      "id": "150s_scene_11_02",
      "text": "它举起手里的小木尺，",
      "file": "sentences/150s_scene_11_02.wav",
      "duration_sec": 1.7241043083900227,
      "start_sec": 95.1597052154195,
      "end_sec": 96.88380952380952,
      "scene_tag": "scene_11"
    },
    {
      "id": "150s_scene_11_03",
      "text": "对准远方，小木尺，",
      "file": "sentences/150s_scene_11_03.wav",
      "duration_sec": 1.868049886621315,
      "start_sec": 97.00380952380952,
      "end_sec": 98.87185941043084,
      "scene_tag": "scene_11"
    },
    {
      "id": "150s_scene_11_04",
      "text": "就成了一座桥。",
      "file": "sentences/150s_scene_11_04.wav",
      "duration_sec": 1.18702947845805,
      "start_sec": 98.99185941043083,
      "end_sec": 100.17888888888889,
      "scene_tag": "scene_11"
    },
    {
      "id": "150s_scene_12_01",
      "text": "最后一站是灯塔。",
      "file": "sentences/150s_scene_12_01.wav",
      "duration_sec": 1.3945351473922902,
      "start_sec": 105.08,
      "end_sec": 106.47453514739229,
      "scene_tag": "scene_12"
    },
    {
      "id": "150s_scene_12_02",
      "text": "守塔人老陈说，",
      "file": "sentences/150s_scene_12_02.wav",
      "duration_sec": 1.3593877551020408,
      "start_sec": 106.59453514739229,
      "end_sec": 107.95392290249433,
      "scene_tag": "scene_12"
    },
    {
      "id": "150s_scene_12_03",
      "text": "在海水淹没它之前，",
      "file": "sentences/150s_scene_12_03.wav",
      "duration_sec": 1.764875283446712,
      "start_sec": 108.07392290249433,
      "end_sec": 109.83879818594104,
      "scene_tag": "scene_12"
    },
    {
      "id": "150s_scene_12_04",
      "text": "能不能再亮一次。",
      "file": "sentences/150s_scene_12_04.wav",
      "duration_sec": 1.3999092970521543,
      "start_sec": 109.95879818594105,
      "end_sec": 111.3587074829932,
      "scene_tag": "scene_12"
    },
    {
      "id": "150s_scene_13_01",
      "text": "灯亮了。",
      "file": "sentences/150s_scene_13_01.wav",
      "duration_sec": 0.7193877551020408,
      "start_sec": 114.03172335600907,
      "end_sec": 114.75111111111111,
      "scene_tag": "scene_13"
    },
    {
      "id": "150s_scene_13_02",
      "text": "光越过海面，照到山的那一边。",
      "file": "sentences/150s_scene_13_02.wav",
      "duration_sec": 2.540045351473923,
      "start_sec": 114.8711111111111,
      "end_sec": 117.41115646258504,
      "scene_tag": "scene_13"
    },
    {
      "id": "150s_scene_14_01",
      "text": "山上，四十盏手电，",
      "file": "sentences/150s_scene_14_01.wav",
      "duration_sec": 1.9449659863945579,
      "start_sec": 119.4559410430839,
      "end_sec": 121.40090702947846,
      "scene_tag": "scene_14"
    },
    {
      "id": "150s_scene_14_02",
      "text": "一盏一盏亮了起来。",
      "file": "sentences/150s_scene_14_02.wav",
      "duration_sec": 1.471111111111111,
      "start_sec": 121.52090702947845,
      "end_sec": 122.99201814058956,
      "scene_tag": "scene_14"
    },
    {
      "id": "150s_scene_14_03",
      "text": "搬走的人们，都看见了。",
      "file": "sentences/150s_scene_14_03.wav",
      "duration_sec": 1.9808390022675737,
      "start_sec": 123.11201814058957,
      "end_sec": 125.09285714285714,
      "scene_tag": "scene_14"
    },
    {
      "id": "150s_scene_15_01",
      "text": "回到邮局，还有最后一封信。",
      "file": "sentences/150s_scene_15_01.wav",
      "duration_sec": 2.321111111111111,
      "start_sec": 128.08,
      "end_sec": 130.4011111111111,
      "scene_tag": "scene_15"
    },
    {
      "id": "150s_scene_15_02",
      "text": "收信人是 EGGBOY 自己。",
      "file": "sentences/150s_scene_15_02.wav",
      "duration_sec": 1.9751020408163265,
      "start_sec": 130.5211111111111,
      "end_sec": 132.49621315192744,
      "scene_tag": "scene_15"
    },
    {
      "id": "150s_scene_15_03",
      "text": "——回家吧。",
      "file": "sentences/150s_scene_15_03.wav",
      "duration_sec": 0.7425396825396825,
      "start_sec": 132.61621315192744,
      "end_sec": 133.3587528344671,
      "scene_tag": "scene_15"
    },
    {
      "id": "150s_scene_15_04",
      "text": "山这边的新邮局，",
      "file": "sentences/150s_scene_15_04.wav",
      "duration_sec": 1.5310884353741496,
      "start_sec": 133.47875283446712,
      "end_sec": 135.00984126984127,
      "scene_tag": "scene_15"
    },
    {
      "id": "150s_scene_15_05",
      "text": "一直给你留着位置。",
      "file": "sentences/150s_scene_15_05.wav",
      "duration_sec": 1.541904761904762,
      "start_sec": 135.12984126984128,
      "end_sec": 136.67174603174604,
      "scene_tag": "scene_15"
    },
    {
      "id": "150s_scene_16_01",
      "text": "这座小镇里的每一栋房子、",
      "file": "sentences/150s_scene_16_01.wav",
      "duration_sec": 2.0034467120181407,
      "start_sec": 136.9984126984127,
      "end_sec": 139.00185941043082,
      "scene_tag": "scene_16"
    },
    {
      "id": "150s_scene_16_02",
      "text": "每一件旧物，都由 Lux3D 生成。",
      "file": "sentences/150s_scene_16_02.wav",
      "duration_sec": 2.886394557823129,
      "start_sec": 139.12185941043083,
      "end_sec": 142.00825396825397,
      "scene_tag": "scene_16"
    },
    {
      "id": "150s_scene_16_03",
      "text": "而你写下的心愿，",
      "file": "sentences/150s_scene_16_03.wav",
      "duration_sec": 1.4335147392290248,
      "start_sec": 142.12825396825397,
      "end_sec": 143.561768707483,
      "scene_tag": "scene_16"
    },
    {
      "id": "150s_scene_16_04",
      "text": "也会在这里，变成真的。",
      "file": "sentences/150s_scene_16_04.wav",
      "duration_sec": 2.1048979591836736,
      "start_sec": 143.681768707483,
      "end_sec": 145.78666666666666,
      "scene_tag": "scene_16"
    }
  ],
  "subtitles": [
    {
      "start_sec": 0.08,
      "end_sec": 2.119002,
      "text": "潮汐镇的人，都搬走了。",
      "scene_tag": "scene_01",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 2.239002,
      "end_sec": 3.817211,
      "text": "海水一天比一天高，",
      "scene_tag": "scene_01",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 3.937211,
      "end_sec": 5.042154,
      "text": "没有人再回来。",
      "scene_tag": "scene_01",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 8.291995,
      "end_sec": 10.650726,
      "text": "只有邮局里的小机器人 EGGBOY，",
      "scene_tag": "scene_02",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 10.770726,
      "end_sec": 12.111474,
      "text": "每天早上醒来，",
      "scene_tag": "scene_02",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 12.231474,
      "end_sec": 14.181746,
      "text": "背起邮包，照常出门。",
      "scene_tag": "scene_02",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 20.08,
      "end_sec": 22.924354,
      "text": "它送的信，收信人都已经不在了。",
      "scene_tag": "scene_03",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 23.044354,
      "end_sec": 25.89873,
      "text": "林阿婆写给陪了她四十二年的烤炉：",
      "scene_tag": "scene_03",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 26.01873,
      "end_sec": 28.220045,
      "text": "老伙计，请再生一次火吧。",
      "scene_tag": "scene_03",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 31.687982,
      "end_sec": 33.094082,
      "text": "可是火柴受了潮，",
      "scene_tag": "scene_04",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 33.214082,
      "end_sec": 34.281338,
      "text": "柴也是湿的。",
      "scene_tag": "scene_04",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 36.095306,
      "end_sec": 38.829093,
      "text": "EGGBOY 把信里的「柴火」两个字撕下来，",
      "scene_tag": "scene_05",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 38.949093,
      "end_sec": 41.564717,
      "text": "扔出去，地上真的长出一捆柴——",
      "scene_tag": "scene_05",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 41.684717,
      "end_sec": 42.91458,
      "text": "只是湿漉漉的，",
      "scene_tag": "scene_05",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 43.03458,
      "end_sec": 43.768821,
      "text": "点不着。",
      "scene_tag": "scene_05",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 47.236757,
      "end_sec": 48.7039,
      "text": "它想起另一封信里，",
      "scene_tag": "scene_06",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 48.8239,
      "end_sec": 49.826871,
      "text": "有一个「干」字。",
      "scene_tag": "scene_06",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 49.946871,
      "end_sec": 51.9161,
      "text": "拼在一起，再扔一次。",
      "scene_tag": "scene_06",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 52.0361,
      "end_sec": 53.619683,
      "text": "炉火，烧起来了。",
      "scene_tag": "scene_06",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 58.08,
      "end_sec": 60.62644,
      "text": "在这个小镇，信里写过的东西，",
      "scene_tag": "scene_07",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 60.74644,
      "end_sec": 62.001179,
      "text": "都能变成真的。",
      "scene_tag": "scene_07",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 62.121179,
      "end_sec": 64.568662,
      "text": "阿萤写信给走丢的小狗小黑：",
      "scene_tag": "scene_07",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 64.688662,
      "end_sec": 67.125737,
      "text": "我把你的碗，放回了学校后门。",
      "scene_tag": "scene_07",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 69.463356,
      "end_sec": 70.361293,
      "text": "碗是空的。",
      "scene_tag": "scene_08",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 70.481293,
      "end_sec": 72.526281,
      "text": "EGGBOY 在心愿笺上写下",
      "scene_tag": "scene_08",
      "timing_method": "edge_tts_word_boundary"
    },
    {
      "start_sec": 72.526281,
      "end_sec": 73.995011,
      "text": "「一根香喷喷的骨头」，",
      "scene_tag": "scene_08",
      "timing_method": "edge_tts_word_boundary"
    },
    {
      "start_sec": 74.115011,
      "end_sec": 76.076576,
      "text": "骨头就从纸上长了出来。",
      "scene_tag": "scene_08",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 78.196417,
      "end_sec": 79.784376,
      "text": "小黑从滑梯底下，",
      "scene_tag": "scene_09",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 79.904376,
      "end_sec": 80.831202,
      "text": "探出了头。",
      "scene_tag": "scene_09",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 82.08,
      "end_sec": 83.529501,
      "text": "潮水漫过了渡口。",
      "scene_tag": "scene_10",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 83.649501,
      "end_sec": 85.236417,
      "text": "一个人摇不动绞盘，",
      "scene_tag": "scene_10",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 85.356417,
      "end_sec": 86.621859,
      "text": "它就按下怀表，",
      "scene_tag": "scene_10",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 86.741859,
      "end_sec": 89.253129,
      "text": "让十秒前的自己回来搭把手。",
      "scene_tag": "scene_10",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 93.759138,
      "end_sec": 95.039705,
      "text": "断崖上没有桥，",
      "scene_tag": "scene_11",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 95.159705,
      "end_sec": 96.88381,
      "text": "它举起手里的小木尺，",
      "scene_tag": "scene_11",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 97.00381,
      "end_sec": 98.871859,
      "text": "对准远方，小木尺，",
      "scene_tag": "scene_11",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 98.991859,
      "end_sec": 100.178889,
      "text": "就成了一座桥。",
      "scene_tag": "scene_11",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 105.08,
      "end_sec": 106.474535,
      "text": "最后一站是灯塔。",
      "scene_tag": "scene_12",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 106.594535,
      "end_sec": 107.953923,
      "text": "守塔人老陈说，",
      "scene_tag": "scene_12",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 108.073923,
      "end_sec": 109.838798,
      "text": "在海水淹没它之前，",
      "scene_tag": "scene_12",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 109.958798,
      "end_sec": 111.358707,
      "text": "能不能再亮一次。",
      "scene_tag": "scene_12",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 114.031723,
      "end_sec": 114.751111,
      "text": "灯亮了。",
      "scene_tag": "scene_13",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 114.871111,
      "end_sec": 117.411156,
      "text": "光越过海面，照到山的那一边。",
      "scene_tag": "scene_13",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 119.455941,
      "end_sec": 121.400907,
      "text": "山上，四十盏手电，",
      "scene_tag": "scene_14",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 121.520907,
      "end_sec": 122.992018,
      "text": "一盏一盏亮了起来。",
      "scene_tag": "scene_14",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 123.112018,
      "end_sec": 125.092857,
      "text": "搬走的人们，都看见了。",
      "scene_tag": "scene_14",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 128.08,
      "end_sec": 130.401111,
      "text": "回到邮局，还有最后一封信。",
      "scene_tag": "scene_15",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 130.521111,
      "end_sec": 132.496213,
      "text": "收信人是 EGGBOY 自己。",
      "scene_tag": "scene_15",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 132.616213,
      "end_sec": 133.358753,
      "text": "——回家吧。",
      "scene_tag": "scene_15",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 133.478753,
      "end_sec": 135.009841,
      "text": "山这边的新邮局，",
      "scene_tag": "scene_15",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 135.129841,
      "end_sec": 136.671746,
      "text": "一直给你留着位置。",
      "scene_tag": "scene_15",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 136.998413,
      "end_sec": 139.001859,
      "text": "这座小镇里的每一栋房子、",
      "scene_tag": "scene_16",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 139.121859,
      "end_sec": 142.008254,
      "text": "每一件旧物，都由 Lux3D 生成。",
      "scene_tag": "scene_16",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 142.128254,
      "end_sec": 143.561769,
      "text": "而你写下的心愿，",
      "scene_tag": "scene_16",
      "timing_method": "exact_individual_tts_clip"
    },
    {
      "start_sec": 143.681769,
      "end_sec": 145.786667,
      "text": "也会在这里，变成真的。",
      "scene_tag": "scene_16",
      "timing_method": "exact_individual_tts_clip"
    }
  ],
